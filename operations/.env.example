# Set in process environment; this tool does not read or overwrite backend/.env.
BACKUP_DIR=REPLACE_WITH_ABSOLUTE_CANONICAL_BACKUP_PATH
PGHOST=REPLACE_WITH_DATABASE_HOST
PGPORT=5432
PGDATABASE=REPLACE_WITH_PRIMARY_DATABASE
PGUSER=REPLACE_WITH_BACKUP_ROLE
PGPASSFILE=REPLACE_WITH_PRIVATE_PGPASS_PATH
PGSSLMODE=verify-full
RETENTION_DAYS=7
# Restore only, pre-created empty separate database (never the primary):
RECOVERY_DB_NAME=cloudnest_recovery_review
RESTORE_CONFIRM=cloudnest_recovery_review
BACKUP_FILE=REPLACE_WITH_GENERATED_ARCHIVE_BASENAME
