{
  "uid": "cloudnest-operations",
  "title": "CloudNest queue and backup — pending integration",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Email queue jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudnest-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudnest_email_queue_jobs",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudnest-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed processing attempts",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudnest-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(cloudnest_email_worker_failures_total[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudnest-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Worker duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudnest-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(cloudnest_email_worker_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudnest-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Last successful mailbox poll age",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudnest-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-cloudnest_email_last_poll_success_timestamp_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudnest-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Last confirmed import age",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudnest-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-cloudnest_email_last_import_success_timestamp_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudnest-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Last backup outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudnest-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudnest_backup_last_outcome",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudnest-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Last successful backup age",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudnest-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-cloudnest_backup_last_success_timestamp_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudnest-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    }
  ]
}