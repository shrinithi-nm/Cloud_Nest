# Private values/files; never commit .env or tokens. No service is started by tests.
QUEUE_REDIS_URL=redis://127.0.0.1:6379
TASK_IMPORT_BASE_URL=http://127.0.0.1:5000
TASK_IMPORT_TOKEN_FILE=REPLACE_WITH_PRIVATE_FILE_PATH
MAILBOX_CONNECTION_ID=REPLACE_WITH_VERIFIED_CONNECTION_ID
IMAP_HOST=REPLACE_WITH_PROVIDER_HOST
IMAP_USER=REPLACE_WITH_MAILBOX_ADDRESS
IMAP_PASSWORD_FILE=REPLACE_WITH_APP_PASSWORD_FILE
# Or IMAP_ACCESS_TOKEN_FILE for a current provider OAuth access token. Refresh belongs to connection service.
WORKER_CONCURRENCY=2
WORKER_METRICS_ENABLED=false
# WORKER_METRICS_TOKEN_FILE=REPLACE_WITH_PRIVATE_FILE_PATH
