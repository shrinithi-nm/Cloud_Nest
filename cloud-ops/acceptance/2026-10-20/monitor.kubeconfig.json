{
  "apiVersion": "v1",
  "kind": "Config",
  "clusters": [
    {
      "name": "docker-desktop-loopback",
      "cluster": {
        "server": "http://127.0.0.1:18001",
        "insecure-skip-tls-verify": true
      }
    }
  ],
  "users": [
    {
      "name": "impersonated-loopback",
      "user": {}
    }
  ],
  "contexts": [
    {
      "name": "docker-desktop",
      "context": {
        "cluster": "docker-desktop-loopback",
        "user": "impersonated-loopback",
        "namespace": "default"
      }
    }
  ],
  "current-context": "docker-desktop"
}