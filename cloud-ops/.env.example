# Local mode is loopback only. No database or service secret required.
PORT=4100
KUBE_NAMESPACE=default
KUBE_DEPLOYMENT=cloudnest-frontend
KUBE_POD_SELECTOR=app=cloudnest-frontend
KUBE_HPA=cloudnest-frontend-hpa
# Optional explicit local context; blank uses current kubeconfig context.
KUBE_CONTEXT=

# Separate load-controller process. Safe default: no mutations.
CONTROLLER_PORT=4101
CLOUD_LOAD_ENABLED=false
KUBE_FRONTEND_SERVICE=cloudnest-frontend-service
# Optional separate, restricted kubeconfig context for the controller.
KUBE_CONTROLLER_CONTEXT=

# Step 3: disabled by default. Dedicated metrics-only endpoint, bearer-authenticated.
METRICS_ENABLED=false
METRICS_BIND_HOST=127.0.0.1
METRICS_PORT=9464
METRICS_TOKEN_FILE=
# Controller process uses the same variables; set METRICS_PORT=9465 in its terminal.
# Empty means unconfigured. Set only in the server environment, not VITE_*.
PROMETHEUS_URL=
GRAFANA_URL=
